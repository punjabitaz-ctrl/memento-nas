# ─────────────────────────────────────────────────────────────────────────────
# Memento Environment Configuration
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#   nano .env
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Encryption key for your vault — AES-256-GCM (32 bytes = 64 hex characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️  CRITICAL: Back this up somewhere safe (password manager, printed paper,
#     USB drive in a different location). Losing this key means your files
#     are permanently unreadable. It does NOT need to change after setup.
MEMENTO_KEY=REPLACE_WITH_YOUR_64_CHAR_HEX_KEY

# Session secret — used to sign session cookies. Any long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_ANOTHER_RANDOM_STRING

# ── STORAGE (NAS) ────────────────────────────────────────────────────────────

# Folder on the NAS where Memento keeps everything (db/, vault/, sessions/).
# Create it first. Examples:
#   Synology: /volume1/docker/memento     QNAP: /share/Container/memento
# Leave as ./data to store next to this file (fine for a trial run).
MEMENTO_DATA=./data

# Numeric user/group that owns MEMENTO_DATA. Find them with:  ls -ln /volume1/docker
# TrueNAS apps user: 568:568. Synology admin is often 1026:100. Plain Linux: 1000:1000.
PUID=1000
PGID=1000

# ── NETWORKING ────────────────────────────────────────────────────────────────

# Port on your NAS that Memento will be reachable on.
# Change if 3002 conflicts with another container.
HOST_PORT=3002

# Set to true if Memento is behind a reverse proxy (Nginx Proxy Manager, Traefik,
# Synology's built-in reverse proxy, Tailscale serve...). Needed for secure cookies over HTTPS.
# NOTE: browsers only allow the microphone on HTTPS (or localhost), so the in-app
# voice recorder needs one of those. Plain http://nas-ip:3002 still supports uploads.
TRUST_PROXY=false

# Domain name for the Traefik variant (docker-compose.traefik.yml only).
# Example: memento.home.local or memories.yourdomain.com
MEMENTO_DOMAIN=memento.home.local

# ── AI (OPTIONAL) ─────────────────────────────────────────────────────────────

# Leave blank to run fully offline (built-in organizer; nothing leaves your NAS).
# With a key set, an "Ask Claude" checkbox appears on each memory's Tidy-up panel.
# Only the text of a memory you explicitly tick it for is sent to Anthropic. Never files.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used when "Ask Claude" is ticked. Haiku is fast and cheap.
MEMENTO_AI_MODEL=claude-haiku-4-5-20251001

# ── FILE UPLOADS ──────────────────────────────────────────────────────────────

# Maximum file size in megabytes per upload.
# 500 = 500MB. Increase for large video files (e.g. 4000 for 4GB).
MAX_FILE_SIZE_MB=500

# ── INTERNALS (usually no need to change) ─────────────────────────────────────

# Directory inside the container where data is stored.
# Maps to MEMENTO_DATA above. Do not change unless you know what you're doing.
DATA_DIR=/data

# Port the Node.js server listens on inside the container.
PORT=3002
